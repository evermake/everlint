{
  "name": "everlint",
  "version": "0.1.0",
  "description": "An opinionated all-in-one linter.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/evermake/everlint.git"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "lint": "bun run src/everlint.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/everlint.ts --compile --outfile dist/everlint"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
